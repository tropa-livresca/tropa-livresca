// Documentação do Modelo de Dados (Supabase/PostgreSQL)

Table public.users_profile {
  id uuid [pk, note: 'UUID integrado ao Supabase Auth']
  nome text [not null]
  telefone varchar [not null]
  imagem text
  descricao text
  redes_sociais jsonb
  is_admin boolean [not null]
  senha_adm text
  primeiro_acesso boolean [not null]
  email text
  is_master boolean
  dados_bancarios jsonb
}

Table public.notificacoes_lidas {
  id bigint [pk, increment]
  fk_notificacao_id bigint [not null]
  fk_user_profile_id uuid [not null]
  data_leitura "timestamp with time zone" [not null]
}

Table public.usuarios_cartoes {
  id bigint [pk, increment]
  token_pagamento text
  final_cartao varchar [not null]
  bandeira_varchar varchar [not null]
  nome_no_cartao text [not null]
  data_expiracao varchar [not null]
  fk_user_profile_id uuid [not null]
}

Table public.itens_venda {
  id bigint [pk, increment]
  qtd bigint [not null]
  subtotal numeric [not null]
  fk_livros_itens_id bigint [not null]
  fk_vendas_id bigint [not null]
}

Table public.comentarios {
  id bigint [pk, increment]
  data "timestamp with time zone" [not null]
  texto text [not null]
  fk_user_profile_id uuid [not null]
  fk_livros_id bigint
}

Table public.livros {
  id bigint [pk, increment]
  direitos_de_publicacao boolean [not null]
  conteudo_por_IA boolean [not null]
  imagens_explicitas boolean [not null]
  numero_edicao smallint
  data_de_publicacao date [not null]
  preco_digital numeric [not null]
  preco_fisico numeric [not null]
  titulo text [not null]
  subtitulo text [not null]
  descricao text [not null]
  autor_nome text [not null]
  autor_sobrenome text [not null]
  fk_user_profile_id uuid [not null]
  ativo boolean [not null]
  estado varchar [not null]
  idioma text [not null]
  manuscrito text
  colaboradores jsonb
  capa jsonb
  categoria text
  ISBN text
  palavras_chave text
  numero_paginas smallint
}

Table public.avaliacoes {
  id bigint [pk, increment]
  data_criacao "timestamp with time zone" [not null]
  fk_livros_id bigint [not null]
  fk_users_profile_id uuid [not null]
}

Table public.vendas {
  id bigint [pk, increment]
  data "timestamp with time zone" [not null]
  total numeric [not null]
  fk_met_pagamentos_id bigint [not null]
  transacao_id text [not null]
  status_pagamento text [not null]
  fk_user_profile_id uuid [not null]
  endereco_entrega jsonb
  status_entrega text [not null]
}

Table public.movimentacoes_financeiras {
  id bigint [pk, increment]
  data "timestamp with time zone" [not null]
  fk_user_profile_id uuid [not null]
  fk_vendas_id bigint [not null]
  tipo text [not null]
  valor numeric [not null]
  descricao text [not null]
  status text [not null]
}

Table public.enderecos {
  id bigint [pk, increment]
  estado varchar [not null]
  bairro text [not null]
  rua text [not null]
  num integer [not null]
  cep varchar [not null]
  fk_user_profile_id uuid [not null]
  cidade text [not null]
  complemento text
  pais text
  ativo boolean
  principal boolean
}

Table public.met_pagamentos {
  id bigint [pk, note: 'Tabela de domínio para tipos de pagamento']
  nome text [not null]
}

Table public.revisoes {
  id bigint [pk, increment]
  arquivo text [not null]
  data_criacao "timestamp with time zone" [not null]
  apontamento text
  fk_user_profile_id uuid [not null]
  fk_livro_id bigint [not null]
  nome text
  completado boolean [not null]
}

Table public.notificacoes {
  id bigint [pk, increment]
  texto text [not null]
  tipo text [not null]
  data "timestamp without time zone" [not null]
  ADM boolean [not null]
  fk_user_profile_id uuid [not null]
  titulo text
  metadados jsonb
  geral boolean [not null]
}

// Relacionamentos e Chaves Estrangeiras (Limpos e Sem Duplicidade)

Ref: public.movimentacoes_financeiras.fk_vendas_id > public.vendas.id
Ref: public.movimentacoes_financeiras.fk_user_profile_id > public.users_profile.id

Ref: public.comentarios.fk_user_profile_id > public.users_profile.id

Ref: public.itens_venda.fk_livros_itens_id > public.livros.id
Ref: public.itens_venda.fk_vendas_id > public.vendas.id

Ref: public.vendas.fk_met_pagamentos_id > public.met_pagamentos.id
Ref: public.vendas.fk_user_profile_id > public.users_profile.id

Ref: public.revisoes.fk_livro_id > public.livros.id
Ref: public.revisoes.fk_user_profile_id > public.users_profile.id

Ref: public.notificacoes.fk_user_profile_id > public.users_profile.id
Ref: public.enderecos.fk_user_profile_id > public.users_profile.id
Ref: public.usuarios_cartoes.fk_user_profile_id > public.users_profile.id
Ref: public.livros.fk_user_profile_id > public.users_profile.id

Ref: public.avaliacoes.fk_livros_id > public.livros.id
Ref: public.avaliacoes.fk_users_profile_id > public.users_profile.id

Ref: public.notificacoes_lidas.fk_notificacao_id > public.notificacoes.id
Ref: public.notificacoes_lidas.fk_user_profile_id > public.users_profile.id
